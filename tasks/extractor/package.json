{
  "name": "extractor",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "azure-devops-node-api": "^15.1.3",
    "azure-pipelines-task-lib": "^5.2.4",
    "winston": "^3.7.2"
  },
  "scripts": {
    "integrationTest": "npm run build && tsc tests/integration/setup.ts && ts-mocha --paths tests/integration/*.test.ts",
    "test": "ts-mocha --paths tests/unit/*.test.ts",
    "test:watch": "ts-mocha --paths tests/unit/*.test.ts -w --watch-files **/*.ts",
    "lint:check": "eslint ../.. && prettier --check ../.. --ignore-path ../../.prettierignore",
    "lint:fix": "eslint ../.. --fix && prettier --write ../.. --ignore-path ../../.prettierignore",
    "prepare": "cd ../.. && husky install",
    "build": "tsc && tsc-alias"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^4.3.1",
    "@types/chai-as-promised": "^7.1.5",
    "@types/mocha": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.5.0",
    "husky": "^7.0.0",
    "nyc": "^15.1.0",
    "prettier": "^2.6.2",
    "sinon": "^13.0.2",
    "sync-request": "^6.1.0",
    "ts-enum-util": "^4.0.2",
    "ts-mocha": "^10.1.0",
    "ts-sinon": "^2.0.2",
    "tsc-alias": "^1.6.7",
    "tsconfig-paths": "^3.14.1",
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
