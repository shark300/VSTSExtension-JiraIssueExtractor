{
  "name": "extractor",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "azure-devops-node-api": "^15.1.3",
    "azure-pipelines-task-lib": "^5.2.4",
    "winston": "^3.7.2"
  },
  "scripts": {
    "integrationTest": "npm run build && tsc tests/integration/setup.ts && ts-mocha --file ./tests/unit/chai-setup.mjs --paths tests/integration/*.test.ts",
    "test": "ts-mocha --file ./tests/unit/chai-setup.mjs --paths tests/unit/*.test.ts",
    "test:watch": "ts-mocha --file ./tests/unit/chai-setup.mjs --paths tests/unit/*.test.ts -w --watch-files **/*.ts",
    "lint:check": "eslint ../.. && prettier --check ../.. --ignore-path ../../.prettierignore",
    "lint:fix": "eslint ../.. --fix && prettier --write ../.. --ignore-path ../../.prettierignore",
    "prepare": "cd ../.. && husky",
    "build": "tsc && tsc-alias"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "mocha": "^11.0.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "ts-enum-util": "^4.0.2",
    "ts-mocha": "^11.1.0",
    "ts-sinon": "^2.0.2",
    "tsc-alias": "^1.6.7",
    "tsconfig-paths": "^4.2.0",
    "typed-rest-client": "^2.1.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    },
    "mocha": {
      "minimatch": "11.0.8",
      "serialize-javascript": "7.1.4"
    },
    "braces": "3.0.3"
  }
}
